# ---- Gateway server ----
# Port the Shesha React app should point BACKEND_URL at.
PORT=21022
HOST=0.0.0.0
NODE_ENV=development

# ---- Upstream (.NET shesha-core) used by `proxy` mode operations ----
SHESHA_UPSTREAM_URL=http://localhost:21021

# ---- Native auth (used when TokenAuth/Session run in `native` mode) ----
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ISSUER=shesha-node-gateway
JWT_AUDIENCE=shesha-app
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800

# ---- Data layer (native fallback persistence) ----
# :memory: for an ephemeral DB, or a file path e.g. ./data/shesha-gateway.db
DB_PATH=:memory:
DB_SEED=true

# ---- Config-driven routing ----
# Directory holding backends.json + operations.json (defaults to <projectRoot>/config)
# CONFIG_DIR=./config

# ---- CORS ----
# Comma-separated list of allowed origins, or * for any
CORS_ORIGINS=*

# ---- Logging ----
LOG_LEVEL=info
