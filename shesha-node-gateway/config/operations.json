      "id": "modelConfigurations.getAll",
      "shesha": { "method": "GET", "path": "/api/ModelConfigurations/GetAll" },
      "mode": "native",
      "native": "appService.dispatch",
      "description": "Exact match so the paged model list is not swallowed by /api/ModelConfigurations/:id below, which would read 'GetAll' as a GUID. Not a shesha-core route: the Entity Designer's data table needs a paged list and core only exposes the by-name and by-id lookups.",
      "requiresAuth": false,
      "tags": ["entity-designer", "generic", "app-service"]
    },
