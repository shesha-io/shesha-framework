{
  "name": "@shesha/publicportal",
  "version": "0.0.1",
  "private": false,
  "postinstall": "next",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build-shesha": "echo \"Build Shesha\" && cd ../../shesha-reactjs && npm install && npm run build && npm pack && shx mv shesha-io-reactjs-*.tgz ../shesha-functional-tests/publicportal/shesha-local.tgz",
    "preinstall": "npm run build-shesha && npm install shesha-local.tgz --force",
    "export": "next export --webpack",
    "start": "NODE_ENV=production node --max-old-space-size=8192 server.js",
    "build:analyze": "ANALYZE=true npm run build",
    "lint": "eslint src/**/*.ts{,x}",
    "lint-errors": "eslint src/**/*.ts{,x} --quiet",
    "postinstall": "shesha init",
    "knip": "knip"
  },
  "overrides": {
    "eslint": "$eslint",
    "next-navigation-guard": {
      "next": "$next"
    },
    "@react-awesome-query-builder/antd": {
      "antd": "$antd",
      "@ant-design/icons": "$@ant-design/icons"
    }
  },
  "resolutions": {
    "rc-treee": "5.8.2"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@next/bundle-analyzer": "^14.2.4",
    "@shesha-io/reactjs": "file:shesha-local.tgz",
    "@types/react-dom": "^19.2.4",
    "antd": "^6.3.5",
    "next": "^16.3.1",
    "next-navigation-guard": "^0.2.0",
    "qs": "^6.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "styled-components": "^5.2.1",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/styled-components": "^5.1.9",
    "eslint": "^9.39.2",
    "knip": "^6.32.2",
    "shx": "^0.3.4",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npm run lint -- --quiet --fix"
    ]
  }
}
