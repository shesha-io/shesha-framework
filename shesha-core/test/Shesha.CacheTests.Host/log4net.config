<?xml version="1.0" encoding="utf-8" ?>
<!--
  Console-only logging.

  The functional-test host's config uses a custom FilePatternConverter from its own assembly and
  writes rolling files under App_Data. Neither is wanted here: three containers would need
  separate log volumes, and `docker logs` is the natural place to look when a container in the rig
  misbehaves.
-->
<log4net>
  <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
    <threshold value="WARN" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%-5level %date [%-5.5thread] %-40.40logger - %message%newline" />
    </layout>
  </appender>

  <root>
    <appender-ref ref="ConsoleAppender" />
    <level value="WARN" />
  </root>
</log4net>
