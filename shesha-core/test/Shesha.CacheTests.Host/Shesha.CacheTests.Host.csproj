<Project Sdk="Microsoft.NET.Sdk.Web">

	<!--
	  Purpose-built web host for the cache-coherence rig.

	  This is the application that runs in the three containers. It exists so the test-only
	  diagnostics endpoints and the "no background workers" policy live with the tests rather than
	  as edits to Boxfusion.SheshaFunctionalTests.Web.Host, which stays untouched.

	  It loads the same module graph as that host (SheshaFunctionalTestsWebCoreModule), so the
	  framework behaviour under test (authorization filter, Redis caching, NHibernate) is
	  identical. The differences are deliberate and limited to:
	    * no Hangfire server (storage/client only), so three instances cannot run duplicate jobs
	    * no Swagger UI or GraphQL playground (unused by the tests)
	    * the CacheDiagnostics controller
	-->

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<PreserveCompilationContext>true</PreserveCompilationContext>
		<AssemblyName>Shesha.CacheTests.Host</AssemblyName>
		<RootNamespace>Shesha.CacheTests.Host</RootNamespace>
		<!-- Not a test project: it must not be picked up by `dotnet test`. -->
		<IsTestProject>false</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Abp.Castle.Log4Net" Version="9.0.0" />
		<PackageReference Include="Abp.HangFire.AspNetCore" Version="9.0.0" />
		<PackageReference Include="Hangfire.SqlServer" Version="1.8.6" />
		<PackageReference Include="Hangfire.PostgreSql" Version="1.20.8" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\shesha-functional-tests\backend\src\Boxfusion.SheshaFunctionalTests.Web.Core\Boxfusion.SheshaFunctionalTests.Web.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</None>
		<None Update="log4net.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

</Project>
