{
  "name": "@shesha-io/starter",
  "version": "0.0.1",
  "private": false,
  "postinstall": "next",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "export": "next export",
    "start": "NODE_ENV=production node --max-old-space-size=8192 server.js",
    "build:analyze": "ANALYZE=true next build --webpack",
    "lint": "eslint **/*.{js,jsx,ts,tsx}",
    "prettier": "prettier --write **/*.{js,jsx,ts,tsx}",
    "test": "jest -c test/jest.config.js"
  },
  "publishConfig": {
    "registry": "https://pkgs.dev.azure.com/boxfusion/_packaging/npm.shesha.dev/npm/registry/"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/nextjs-registry": "^1.0.0",
    "@microsoft/applicationinsights-react-js": "^3.1.2",
    "@microsoft/applicationinsights-web": "^2.6.2",
    "@microsoft/signalr": "^8.0.0",
    "@next/bundle-analyzer": "^16.3.1",
    "@shesha-io/reactjs": "0.46.0",
    "@types/react-dom": "^19.2.0",
    "antd": "^6.6.2",
    "antd-style": "^4.1.0",
    "axios": "^1.7.2",
    "camelcase": "^6.2.0",
    "config": "^3.3.6",
    "file-saver": "^2.0.5",
    "history": "^5.3.0",
    "htmlescape": "^1.1.1",
    "jodit": "^4.0.6",
    "less": "^4.2.0",
    "nanoid": "^3.1.23",
    "next": "^16.3.1",
    "next-navigation-guard": "^0.2.0",
    "next-nprogress-bar": "^2.3.12",
    "next-with-less": "^3.0.1",
    "npm": "^9.5.0",
    "nprogress": "^0.2.0",
    "prettier": "^2.2.1",
    "qs": "^6.11.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^3.1.4",
    "react-sortablejs": "^6.1.4",
    "react-use": "^17.4.0",
    "sortablejs": "^1.14.0",
    "styled-components": "^5.2.1"
  },
  "overrides": {
    "@antv/component": "2.1.7",
    "next-navigation-guard": {
      "next": "$next"
    },
    "@react-awesome-query-builder/antd": {
      "antd": "$antd",
      "@ant-design/icons": "$@ant-design/icons"
    }
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15",
    "@testing-library/react": "^11.2.3",
    "@types/react": "^19.2.0",
    "@types/redux-actions": "^2.3.1",
    "@types/styled-components": "^5.1.9",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/eslint-plugin-tslint": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "dotenv": "^8.2.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^48.0.4",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^4.3.7",
    "isomorphic-unfetch": "^3.1.0",
    "jest": "^29.7.0",
    "lint-staged": "^10.5.3",
    "nock": "^13.0.6",
    "redux-actions": "^2.6.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npm run lint -- --quiet --fix"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "allowScripts": {
    "@shesha-io/reactjs@0.46.0": true
  }
}
