{
  "name": "@shesha-io/starter",
  "version": "0.0.1",
  "private": false,
  "postinstall": "next",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "export": "next export --webpack",
    "start": "NODE_ENV=production node --max-old-space-size=8192 server.js",
    "build:analyze": "ANALYZE=true npm run build",
    "lint": "eslint **/*.{js,jsx,ts,tsx}"
  },
  "overrides": {
    "eslint": "$eslint",
    "next-navigation-guard": {
      "next": "$next"
    },
    "@rc-component/portal": "2.2.1"
  },
  "publishConfig": {
    "registry": "https://pkgs.dev.azure.com/boxfusion/_packaging/npm.shesha.dev/npm/registry/"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@next/bundle-analyzer": "^14.2.4",
    "@shesha-io/reactjs": "0.0.0-build123239",
    "@types/react-dom": "^19.2.4",
    "antd": "^6.6.2",
    "next": "^16.4.2",
    "next-navigation-guard": "^0.2.0",
    "qs": "^6.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "styled-components": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/styled-components": "^5.1.9",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.2",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "knip": "^6.42.1",
    "moment": "^2.30.1",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npm run lint -- --quiet --fix"
    ]
  }
}
